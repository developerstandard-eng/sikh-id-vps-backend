# Server
PORT=4000
NODE_ENV=production
APP_BASE_URL=https://id.thesikhgroup.com
API_BASE_URL=https://auth.thesikhgroup.com

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sikhid_app
DB_PASSWORD=changeme
DB_NAME=sikh_id_master

# Redis (BullMQ queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# SSO
SSO_SESSION_TTL_MINUTES=43200
# Comma separated list of WordPress domains allowed to call this API / receive SSO redirects
ALLOWED_SITE_DOMAINS=fastlinkinc.com,fonezone.me,newbansalelectronics.com

# Shared secret each WP plugin sends as a header to prove it's a trusted site (rotate per site if you want tighter control)
SITE_SHARED_SECRET=replace_with_a_shared_secret

# Email (Gmail SMTP via nodemailer) — GMAIL_USER needs an App Password,
# not the account's normal login password: Google Account > Security >
# 2-Step Verification > App passwords. Gmail always sends as GMAIL_USER
# itself, so EMAIL_FROM_NAME only controls the display name.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=The Sikh Group

# Reminder cadence (days since last reminder before the next one goes out)
REMINDER_INTERVAL_DAYS=3
REMINDER_MAX_ATTEMPTS=4

# Admin dashboard access (segments + manual campaigns) — replace with a real
# admin auth system once more than one person needs access
ADMIN_API_KEY=replace_with_a_long_random_admin_key
